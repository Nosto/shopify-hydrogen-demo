{
  "include": [
    "env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "app/**/*.js",
    "app/**/*.jsx",
    "app/**/*.d.ts",
    "*.ts",
    "*.tsx",
    "*.d.ts",
    ".react-router/types/**/*"
  ],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "isolatedModules": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["@shopify/oxygen-workers-types", "react-router", "vite/client"],
    "paths": {
      "~/*": ["./app/*"],
      // @nosto/shopify-hydrogen is linked with `file:` and has its own node_modules;
      // resolve its peer types to this app's copies so they stay the same types.
      "@shopify/hydrogen": ["./node_modules/@shopify/hydrogen/dist/core/index.d.mts"],
      "@shopify/hydrogen/customer-account": [
        "./node_modules/@shopify/hydrogen/dist/customer-account/index.d.mts"
      ]
    },
    "rootDirs": [".", "./.react-router/types"],
    "plugins": [{"name": "@shopify/hydrogen/ts-plugin"}]
  }
}
